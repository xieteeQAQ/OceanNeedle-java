# ============================================================
# 跟踪原则
#   1. 源码（src/main/java）与测试（src/test/java）全部跟踪
#   2. 含数据库密码/账号等隐私信息的文件一律不跟踪
#   3. 构建产物、日志等运行时生成的文件不跟踪
#
# 注意：*.java 不再有任何排除规则，测试类必须入库。
# ============================================================

# ------------------------------------------------------------
# 构建产物
# ------------------------------------------------------------
target/
build/
out/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ------------------------------------------------------------
# 运行时产物与日志
# ------------------------------------------------------------
*.log
logs/
.attach_pid*

# ------------------------------------------------------------
# 数据库连接配置（真实密码，绝对不能提交）
#   只提交占位模板 jdbc.properties.example
# ------------------------------------------------------------
jdbc.properties

# ------------------------------------------------------------
# IntelliJ IDEA
#   workspace / dataSources 含本机路径、数据库账号与连接信息 → 不跟踪
#   其余共享配置（编码、代码风格、检查配置）保留跟踪
# ------------------------------------------------------------
.idea/workspace.xml
.idea/dataSources.xml
.idea/dataSources.local.xml
.idea/dataSources/

# 机器相关的自动生成配置
.idea/modules.xml
.idea/jarRepositories.xml
.idea/compiler.xml
.idea/libraries/
.idea/httpRequests/
*.iws
*.iml
*.ipr

# ------------------------------------------------------------
# Eclipse / NetBeans / VS Code
# ------------------------------------------------------------
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
!**/src/main/**/build/
!**/src/test/**/build/

.vscode/

# ------------------------------------------------------------
# 其他
# ------------------------------------------------------------
.DS_Store
.kotlin
*.class
